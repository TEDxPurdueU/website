{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"buildCommand": "npm run build",
	"outputDirectory": "build",
	"cleanUrls": true,
	"trailingSlash": false,
	"redirects": [
		{
			"source": "/(.*)",
			"has": [{ "type": "host", "value": "www.tedxpurdueu.org" }],
			"destination": "https://tedxpurdueu.org/$1",
			"permanent": true
		},
		{
			"source": "/sponsor(.pdf)?",
			"destination": "/sponsors",
			"permanent": false
		}
	]
}
